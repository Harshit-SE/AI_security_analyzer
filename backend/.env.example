PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
RAG_SERVICE_URL=http://127.0.0.1:5001
OLLAMA_MODEL=phi3

# ── Google Gemini Cloud AI (Free tier) ────────────────────────────────────────
# If set, all AI analysis runs 100% in the cloud via Gemini.
# If left blank, falls back to local Ollama (Phi-3).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Authentication (set a strong random value in production) ──────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty to disable API key enforcement (local dev only)
API_KEY=

# ── Proxy trust (set to "true" only when behind exactly 1 reverse proxy) ───────
# Setting this incorrectly allows X-Forwarded-For spoofing to bypass rate limiting
TRUST_PROXY=false

# ── RAG service timeout ───────────────────────────────────────────────────────
RAG_TIMEOUT_MS=300000